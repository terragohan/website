---
import Gohan from './Gohan.astro';

/**
 * Newsletter signup — Kit (kit.com, formerly ConvertKit). Free for up to
 * 10,000 subscribers; Kit earns money from paid tiers and commerce tools,
 * so a free newsletter like ours never pays.
 *
 * SETUP: the form action below is the terragohan Kit form (found via the
 * JS embed snippet). If you ever recreate the form in Kit, grab the new
 * action URL from the form's HTML embed settings.
 */
const FORM_ACTION = 'https://app.kit.com/forms/9830350/subscriptions';
---

<section class="newsletter">
  <Gohan pose="point" size={64} class="newsletter-gohan" />
  <h2 class="newsletter-title">JOIN THE HARVEST LIST</h2>
  <p class="newsletter-desc">get an email every time a new project drops</p>
  <form class="newsletter-form" action={FORM_ACTION} method="post">
    <input
      class="newsletter-input"
      type="email"
      name="email_address"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    <button class="newsletter-button" type="submit">SIGN UP</button>
  </form>
</section>
