---
import Gohan from './Gohan.astro';

/**
 * Newsletter signup — Buttondown (buttondown.com). Developer-friendly:
 * raw HTML form endpoint (no API key needed), full REST API for managing
 * subscribers and drafts programmatically, Markdown-native editor.
 * Free for up to 100 subscribers.
 *
 * SETUP: create the newsletter at buttondown.com, then set the username
 * in the action URL below (https://buttondown.com/api/emails/embed-subscribe/<username>).
 */
const FORM_ACTION = 'https://buttondown.com/api/emails/embed-subscribe/terragohan';
---

<section class="newsletter">
  <Gohan pose="point" size={64} class="newsletter-gohan" />
  <h2 class="newsletter-title">JOIN THE HARVEST LIST</h2>
  <p class="newsletter-desc">get an email every time a new project drops</p>
  <form class="newsletter-form" action={FORM_ACTION} method="post">
    <input
      class="newsletter-input"
      type="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    <button class="newsletter-button" type="submit">SIGN UP</button>
  </form>
</section>
