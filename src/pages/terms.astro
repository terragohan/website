---
import Seo from '../components/Seo.astro';
import '../styles/global.css';

const pageDescription =
  'Terms and attribution for terragohan — Dragon Ball fan-project disclaimer, credits, fonts, and privacy (no trackers, no cookies).';

const jsonLd = [
  {
    '@type': 'WebPage',
    name: 'terragohan — terms & attribution',
    url: new URL('/terms', Astro.site ?? 'https://terragohan.com').href,
    description: pageDescription,
    inLanguage: 'en',
    isPartOf: { '@id': new URL('/#website', Astro.site ?? 'https://terragohan.com').href },
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title="terragohan — terms & attribution"
      description={pageDescription}
      path="/terms"
      jsonLd={jsonLd}
      cspExtra="form-action https://buttondown.com; connect-src https://buttondown.com"
    />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline src="/scripts/theme.js"></script>
  </head>
  <body>
    <main class="terms">
      <h1 class="wordmark">TERMS &<br />ATTRIBUTION</h1>

      <section class="entry">
        <h2 class="entry-title">Dragon Ball attribution</h2>
        <p class="entry-desc">
          The mascot on this site is original pixel art referencing
          <strong>Gohan</strong>, a character from
          <strong>Dragon Ball Z</strong> and the broader
          <strong>Dragon Ball</strong> franchise. Dragon Ball was created by
          <strong>Akira Toriyama</strong>, and the characters and franchise are
          the property of their respective rights holders, including
          <strong>Bird Studio</strong>, <strong>Shueisha</strong>, and
          <strong>Toei Animation</strong>.
        </p>
        <p class="entry-desc">
          This is a personal, non-commercial fan project. It is not affiliated
          with, endorsed by, or sponsored by any of the rights holders above.
          If you are a rights holder and would like anything changed or removed,
          please get in touch and it will be taken care of promptly.
        </p>
      </section>

      <section class="entry">
        <h2 class="entry-title">Everything else</h2>
        <p class="entry-desc">
          The site itself — code, layout, and original artwork — is made by
          terragohan. The fonts used are
          <strong>Press Start 2P</strong> (CodeMan38) and
          <strong>DotGothic16</strong> (Fontworks), both under the
          SIL Open Font License.
        </p>
        <p class="entry-desc">
          No trackers, no cookies, no accounts. Just a calendar of things we're
          making.
        </p>
      </section>

      <p class="terms-back"><a href="/" class="entry-link">&larr; BACK TO THE CALENDAR</a></p>
    </main>
  </body>
</html>
