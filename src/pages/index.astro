---
import { getCollection } from 'astro:content';
import ReleaseEntry, { type EntryState } from '../components/ReleaseEntry.astro';
import Gohan from '../components/Gohan.astro';
import Seo from '../components/Seo.astro';
import '../styles/global.css';

const entries = (await getCollection('releases')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

const now = Date.now();
const TWO_WEEKS = 14 * 24 * 60 * 60 * 1000;

const isReleased = (e: (typeof entries)[number]) =>
  Boolean(e.data.url) && e.data.title !== '???';

// First unreleased entry is the "next drop".
const nextEntry = entries.find((e) => !isReleased(e));

const items = entries.map((e) => {
  let state: EntryState;
  if (isReleased(e)) {
    state = 'released';
  } else if (e === nextEntry) {
    state = 'next';
  } else {
    state = 'upcoming';
  }

  let gohanPose: 'point' | 'sleep' | 'celebrate' | null = null;
  if (state === 'next') {
    gohanPose = 'point';
  } else if (state === 'upcoming' && nextEntry && e.data.date.getTime() - nextEntry.data.date.getTime() > 2 * TWO_WEEKS) {
    gohanPose = 'sleep';
  } else if (state === 'released') {
    gohanPose = 'celebrate';
  }

  return { ...e.data, state, gohanPose };
});

const site = Astro.site ?? new URL('https://terragohan.com');
const pageDescription =
  'The terragohan harvest calendar: a new indie project, tool, or video every two weeks. See the next drop and browse everything we have shipped.';
const released = items.filter((item) => item.state === 'released');

const orgNode = {
  '@type': 'Organization',
  '@id': new URL('/#org', site).href,
  name: 'terragohan',
  url: new URL('/', site).href,
  logo: new URL('/logo-480.png', site).href,
};

const jsonLd = [
  orgNode,
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', site).href,
    name: 'terragohan — harvest calendar',
    url: new URL('/', site).href,
    inLanguage: 'en',
    publisher: { '@id': orgNode['@id'] },
  },
  {
    '@type': 'WebPage',
    '@id': new URL('/#calendar', site).href,
    name: 'terragohan — harvest calendar',
    url: new URL('/', site).href,
    description: pageDescription,
    inLanguage: 'en',
    isPartOf: { '@id': new URL('/#website', site).href },
    mainEntity: { '@id': new URL('/#releases', site).href },
  },
  {
    '@type': 'ItemList',
    '@id': new URL('/#releases', site).href,
    name: 'terragohan harvest releases',
    url: new URL('/', site).href,
    numberOfItems: released.length,
    itemListElement: released.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      description: item.description,
      url: item.url,
    })),
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title="terragohan — harvest calendar"
      description={pageDescription}
      path="/"
      jsonLd={jsonLd}
    />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="terragohan — harvest" href="/rss.xml" />
    <script is:inline src="/scripts/theme.js"></script>
  </head>
  <body>
    <header class="site-header">
      <Gohan pose="wave" size={96} class="header-gohan" />
      <h1 class="wordmark">TERRAGOHAN</h1>
      <p class="tagline">something new every two weeks</p>
    </header>

    <main class="calendar">
      {items.map((item) => <ReleaseEntry {...item} />)}
    </main>

    <footer class="site-footer">
      <Gohan pose="wave" size={64} />
      <p>harvested with love by terragohan</p>
      <p>
        <a href="/terms" class="to-top">terms & attribution</a> ·
        <a href="#top" class="to-top">back to top &uarr;</a>
      </p>
    </footer>

    <script is:inline src="/scripts/countdown.js"></script>
  </body>
</html>
